  async function handleAttachFile(event: ChangeEvent<HTMLInputElement>) {
    const files = Array.from(event.target.files || [])
    if (!files.length) return
    try {
      const newAttachments: AttachmentItem[] = []
      const textParts: string[] = []
      const readAsDataUrl = (file: File) =>
        new Promise<string>((resolve, reject) => {
          const reader = new FileReader()
          reader.onload = () => resolve(String(reader.result || ''))
          reader.onerror = () => reject(reader.error)
          reader.readAsDataURL(file)
        })
      for (const file of files) {
        const isTextLike =
          file.type.startsWith('text/') ||
          /\.(txt|md|json|csv|log|py|js|ts|tsx|html|css|xml|yaml|yml|pdf|docx)$/i.test(file.name)
        if (file.type.startsWith('image/')) {
          const imageUrl = await readAsDataUrl(file)
          newAttachments.push({ name: file.name, type: file.type || 'imagem', url: imageUrl, size: file.size })
        } else if (isTextLike && !/\.(pdf|docx)$/i.test(file.name)) {
          const text = await file.text()
          textParts.push(`Arquivo anexado: ${file.name}\n\n${text.slice(0, 12000)}`)
          newAttachments.push({ name: file.name, type: file.type || 'documento', text: text.slice(0, 12000), size: file.size })
        } else {
          const attachment: AttachmentItem = { name: file.name, type: file.type || 'arquivo', size: file.size }
          if (file.size <= 4 * 1024 * 1024) {
            attachment.url = await readAsDataUrl(file)
          }
          newAttachments.push(attachment)
        }
      }
      setPendingAttachments((current) => [...current, ...newAttachments])
      const summary = `Anexei ${files.length} arquivo(s): ${files.map((file) => file.name).join(', ')}.`
      const textBlock = textParts.join('\n\n')
      appendInput(`${inputRef.current?.value ? '\n\n' : ''}${summary}${textBlock ? `\n\n${textBlock}` : ''}`)
      setStatus(`${files.length} arquivo(s) anexado(s)`)
    } catch {
      setStatus('Nao consegui ler um dos arquivos.')
    } finally {
      event.target.value = ''
    }
  }

