  async function showBmoReplyStreaming(reply: string) {
    let targetIndex = -1
    setMessages((current) => {
      targetIndex = current.length
      return [...current, { role: 'bmo', text: '' }]
    })
    const step = Math.max(2, Math.ceil(reply.length / 140))
    for (let index = step; index < reply.length; index += step) {
      const partial = reply.slice(0, index)
      setMessages((current) => current.map((message, messageIndex) => (messageIndex === targetIndex ? { ...message, text: partial } : message)))
      await new Promise((resolve) => window.setTimeout(resolve, 12))
    }
    setMessages((current) => current.map((message, messageIndex) => (messageIndex === targetIndex ? { ...message, text: reply } : message)))
  }

  async function handleCommand(command: string): Promise<boolean> {
    const normalized = command.trim().toLowerCase()

    if (normalized === 'testar voz' || normalized === 'teste de voz') {
      const reply = 'Teste de voz do BMO funcionando.'
      setMessages((current) => [...current, { role: 'bmo', text: reply }])
      await speak(reply)
      return true
    }

    if (normalized === 'testar lembrete em 10 segundos' || normalized === 'teste lembrete em 10 segundos') {
      const text = 'teste de lembrete do BMO'
      await postJson('/api/reminders', { action: 'create', text, dueAt: Math.floor(Date.now() / 1000) + 10 })
      setMessages((current) => [...current, { role: 'bmo', text: 'Combinado. Vou testar um lembrete em 10 segundos.' }])
      setStateWithStatus('idle', 'Lembrete de teste criado')
      return true
    }

    if (!normalized.startsWith('/')) return false

    if (normalized === '/status') {
      const data = await getJson<SystemState>('/api/system')
      if (data.busy) {
        const reply = 'BMO esta terminando uma conversa agora. Ja volto com o status.'
        setMessages((current) => [...current, { role: 'bmo', text: reply }])
        return true
      }
      setSystem(data)
      const reply = `Status: BMO ${data.backend ? 'online' : 'offline'}, voz ${data.piper ? 'online' : 'offline'}, microfone ${data.whisper ? 'online' : 'offline'}.`
      setMessages((current) => [...current, { role: 'bmo', text: reply }])
      setStateWithStatus('idle', reply)
      return true
    }

    if (normalized === '/restart') {
      setStateWithStatus('thinking', 'Reiniciando BMO...')
      await postJson('/api/service/restart', {})
      await refreshAll()
      setMessages((current) => [...current, { role: 'bmo', text: 'Pronto, reiniciei meus servicos internos.' }])
      setStateWithStatus('idle')
      return true
    }

    if (normalized === '/history') {
      const data = await getJson<{ sessions: HistorySession[] }>('/api/history')
      setHistory(data.sessions || [])
      const top = (data.sessions || []).slice(0, 5)
      const reply = top.length
        ? `Ultimas conversas:\n${top.map((session) => `- ${session.title}`).join('\n')}`
        : 'Ainda nao tenho conversas antigas salvas.'
      setMessages((current) => [...current, { role: 'bmo', text: reply }])
      setStateWithStatus('idle')
      return true
    }

    if (normalized.startsWith('/lembrar ') || normalized.startsWith('/remind ')) {
      const raw = command.replace(/^\/(lembrar|remind)\s+/i, '').trim()
      const match = raw.match(/^(\d+)\s*(min|minutos|m|h|horas)?\s+(.+)$/i)
      if (!match) {
        setMessages((current) => [...current, { role: 'bmo', text: 'Me diga assim: /lembrar 10min beber agua' }])
        return true
      }
      const amount = Number(match[1])
      const unit = (match[2] || 'min').toLowerCase()
      const text = match[3].trim()
      const seconds = unit.startsWith('h') ? amount * 3600 : amount * 60
      await postJson('/api/reminders', { action: 'create', text, dueAt: Math.floor(Date.now() / 1000) + seconds })
      setMessages((current) => [...current, { role: 'bmo', text: `Combinado. Eu vou te lembrar: ${text}` }])
      setStateWithStatus('idle', 'Lembrete criado')
      return true
    }

    setMessages((current) => [...current, { role: 'bmo', text: 'Comando desconhecido. Tente /status, /restart, /history ou /lembrar 10min beber agua.' }])
    setStateWithStatus('idle')
    return true
  }

  async function handleSend(customText?: string) {
    const text = (customText ?? inputRef.current?.value ?? '').trim()
    if (!text && !pendingAttachments.length) return
    clearInput()
    const outgoingText = text || `Arquivos anexados: ${pendingAttachments.map((item) => item.name).join(', ')}`
    const outgoingAttachments = pendingAttachments
    setPendingAttachments([])
    setMessages((current) => [...current, { role: 'user', text: outgoingText, attachments: outgoingAttachments }])
    if (await handleCommand(outgoingText)) return
    setStateWithStatus('thinking')
    void playUiSound('thinking')
    try {
      const data = await postJson<{ reply: string; sessionId?: string; subagent?: SubagentItem; task?: TaskItem }>('/api/chat', {
        message: outgoingText,
        sessionId: activeSessionId,
        language,
        voice: voiceModel,
        attachments: outgoingAttachments.map((attachment) => ({
          name: attachment.name,
          type: attachment.type,
          size: attachment.size,
          url: attachment.url,
          text: attachment.text,
        })),
      })
      if (data.sessionId) rememberActiveSession(data.sessionId)
      const reply = data.reply || 'Eu fiquei sem resposta por um instante. Pode tentar de novo?'
      await showBmoReplyStreaming(reply)
      if (data.subagent) {
        setSubagents((current) => [data.subagent as SubagentItem, ...current])
        setStateWithStatus('idle', 'Subagente trabalhando')
      }
      if (data.task) {
        setTasks((current) => [data.task as TaskItem, ...current])
        setStateWithStatus('idle', 'Tarefa criada')
      }
      void refreshHistory()
      await speak(reply)
      setStateWithStatus('idle')
    } catch (error) {
      const raw = error instanceof Error ? error.message : 'Backend indisponivel'
      const message = friendlyErrorMessage(raw)
      setLastError(message)
      setMessages((current) => [
        ...current,
        { role: 'bmo', text: message },
      ])
      setStateWithStatus('error', message.split('\n')[0])
    }
  }

