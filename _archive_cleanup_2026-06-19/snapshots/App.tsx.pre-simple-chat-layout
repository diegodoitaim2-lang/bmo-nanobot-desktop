                <span>{(settings.whisper?.gpuBackends || system.whisperConfig?.gpuBackends || []).map((item) => item.label).join(', ') || 'Nao encontrado'}</span>
              </p>
            </div>
            <div className="button-row">
              <button disabled={testingWhisper} onClick={() => void testWhisperRuntime()}>
                <Volume2 size={16} /> {testingWhisper ? 'Testando...' : 'Testar Voz'}
              </button>
            </div>
            {whisperTest && (
              <p className={whisperTest.ok ? 'connection-result ok' : 'connection-result error'}>
                {whisperTest.ok ? <CheckCircle2 size={16} /> : <AlertCircle size={16} />} {whisperTest.message}
              </p>
            )}
          </section>
          <section className="config-card">
            <h2>Acessibilidade</h2>
            <label>
              Tamanho do texto do chat
              <input
                type="range"
                min="0.85"
                max="1.35"
                step="0.05"
                value={chatFontScale}
                onChange={(event) => void changeFontScale(Number(event.target.value))}
              />
              <span className="muted">{Math.round(chatFontScale * 100)}%</span>
            </label>
          </section>
          <section className="config-card">
            <h2>Inicializacao</h2>
            <label className="toggle-row">
              Iniciar com o Windows
              <input
                type="checkbox"
                checked={startWithWindows}
                onChange={(event) => {
                  const enabled = event.target.checked
                  setStartWithWindows(enabled)
                  void saveAppPreferences({ startWithWindows: enabled })
                }}
              />
            </label>
            <label>
              Atalho para abrir
              <input
                value={hotkey}
                onChange={(event) => setHotkey(event.target.value)}
                onBlur={() => void saveAppPreferences({ hotkey })}
                placeholder="Ctrl+Alt+B"
              />
            </label>
          </section>
          <section className="config-card">
            <h2>Wake Word</h2>
            <div className="settings-summary">
              <p>
                <strong>Status</strong>
                <span>{system.wakeword?.enabled ? 'Hey BMO ativo' : system.wakeword?.message || 'Aguardando ativacao'}</span>
              </p>
              <p>
                <strong>Modelo</strong>
                <span>{system.wakeword?.model || 'wakeword.onnx'}</span>
              </p>
            </div>
          </section>
          <section className="config-card">
            <h2>Personalidade</h2>
            <p>BMO fofo, divertido, educado e profissional. Ele conversa de forma natural e evita linguagem tecnica quando nao precisa.</p>
            <StatusPill ok label="Perfil BMO ativo" />
          </section>
          <section className="config-card">
            <h2>Aparencia</h2>
            <label className="toggle-row">
              Glow do personagem
              <input type="checkbox" checked readOnly />
            </label>
            <label className="toggle-row">
              Particulas luminosas
              <input type="checkbox" checked readOnly />
            </label>
          </section>
          <section className="config-card">
            <h2>Animacoes</h2>
            <label className="toggle-row">
              BMO flutuando
              <input type="checkbox" checked readOnly />
            </label>
            <label className="toggle-row">
              Monitores ECG
              <input type="checkbox" checked readOnly />
            </label>
          </section>
          <section className="config-card wide">
            <h2>Preferencias</h2>
            <div className="privacy-note">
              Suas conversas ficam apenas no seu PC. Nada é enviado para servidores externos.
            </div>
            <div className="path-list">
              {Object.entries(system.paths || settings.paths || {}).map(([key, value]) => (
                <p key={key}>
                  <strong>{key}</strong>
                  <span>{value}</span>
                  <button onClick={() => void openFolder(key === 'voices' ? 'voices' : key === 'config' ? 'config' : key === 'memory' ? 'memory' : 'appData')}>Abrir pasta</button>
                </p>
              ))}
            </div>
            <div className="button-row">
              <button onClick={() => void openFolder('config')}>
                <Settings size={16} /> Abrir pasta de configuracoes
              </button>
              <button onClick={() => void openFolder('appData')}>
                <Database size={16} /> Abrir pasta de dados
              </button>
            </div>
          </section>
        </div>
      )
    }

    if (activePanel === 'Canais') {
      const displayChannels = channels.length ? channels : channelOptions.map((label) => ({ id: label.toLowerCase(), label, fields: [], enabled: false, configured: false, status: 'desconectado' }))
      return (
        <div className="panel-grid">
          {displayChannels.map((channel) => {
            // Usa schema fixo para garantir que os campos aparecam
            const schema = channelSchemas[channel.id]
            const fieldsToShow = schema ? schema.fields : channel.fields
            const hints = schema?.hints || channelHints[channel.id] || []
            return (
              <section className="config-card" key={channel.id}>
                <h2>{channel.label}</h2>
                <label className="toggle-row">
                  Ativar canal
                  <input type="checkbox" checked={channel.enabled} onChange={(event) => void saveChannel(channel, event.target.checked)} />
                </label>
                {fieldsToShow.length > 0 && (
                  <>
                    {fieldsToShow.map((field, index) => (
                      <label key={field}>
                        {field}
                        <input
                          type={field.toLowerCase().includes('token') || field.toLowerCase().includes('password') || field.toLowerCase().includes('secret') || field.toLowerCase().includes('key') ? 'password' : 'text'}
                          placeholder={hints[index] || field}
                          value={channelSecrets[channel.id]?.[field] || ''}
                          onChange={(event) =>
                            setChannelSecrets((current) => ({
                              ...current,
                              [channel.id]: { ...(current[channel.id] || {}), [field]: event.target.value },
                            }))
                          }
                        />
                      </label>
                    ))}
                    <button onClick={() => void testChannel(channel)}>
                      <RefreshCw size={16} /> Testar conexao
                    </button>
                  </>
                )}
                <StatusPill ok={channel.configured && channel.enabled} label={channel.status} />
              </section>
            )
          })}
        </div>
      )
    }

    if (activePanel === 'Historico') {
      const filtered = history.filter((session) =>
        `${session.title} ${session.preview || ''}`.toLowerCase().includes(historySearch.toLowerCase()),
      )
      return (
        <div className="panel-grid">
          <section className="config-card wide">
            <div className="panel-title-row">
              <div>
                <h2>Historico</h2>
                <p>Conversas salvas automaticamente quando voce conversa com o BMO.</p>
              </div>
              <div className="history-actions">
                <button onClick={() => setHistoryExportOpen((current) => !current)}>
                  <Save size={16} /> Exportar
                </button>
                {historyExportOpen && (
                  <div className="export-menu">
                    <button onClick={() => void exportHistory('txt')}>TXT</button>
                    <button onClick={() => void exportHistory('json')}>JSON</button>
                    <button onClick={() => void exportHistory('md')}>Markdown</button>
                  </div>
                )}
                <button onClick={newSession}>
                  <Bot size={16} /> {ui.newChat}
                </button>
              </div>
            </div>
            <input value={historySearch} placeholder={ui.searchChat} onChange={(event) => setHistorySearch(event.target.value)} />
            <div className="list-stack history-list">
              {filtered.map((session) => (
                <div className={activeSessionId === session.id ? 'list-item active' : 'list-item'} key={session.id}>
                  <button className="list-main" onClick={() => openSession(session)}>
                    <strong>{session.title}</strong>
                    <span>{new Date((session.updatedAt || session.createdAt || 0) * 1000).toLocaleString('pt-BR')}</span>
                    <p>{session.preview || 'Sem preview ainda.'}</p>
                  </button>
                  <button onClick={() => void deleteSession(session.id)} title="Apagar conversa">
                    <Trash2 size={16} />
                  </button>
                </div>
              ))}
              {!filtered.length && <p className="muted">Nenhuma conversa encontrada. Envie uma mensagem no chat para criar a primeira sessao.</p>}
            </div>
          </section>
        </div>
      )
    }

    return <EmptyPanel title={activePanel} text="Esta area sera conectada a uma funcao especifica do BMO." />
  }

  if (booting) {
    return (
      <main className="splash-screen">
        <img src={appIcon} alt="BMO" />
        <h1>BMO</h1>
        <p>Acordando o BMO...</p>
        <div className="loading-bars"><span /><span /><span /></div>
      </main>
    )
  }

  async function refreshSystem() {
    try {
      const data = await getJson<SystemState>('/api/system')
      if (!mountedRef.current) return
      if (data.busy) return
      setSystem(data)
      const eventId = Number(data.wakeword?.eventId || 0)
      if (eventId > wakeEventRef.current && bmoState === 'idle') {
        wakeEventRef.current = eventId
        void handleVoiceChat()
      }
    } catch {
      // The periodic status should never interrupt the chat.
    }
  }

  async function checkDueReminders() {
    try {
      if (document.hidden) return
      const data = await getJson<{ items: ReminderItem[] }>('/api/reminders?due=1')
      if (!mountedRef.current) return
      if (data.items?.length) {
        const next = data.items[0]
        setDueReminder((current) => {
          if (current) return current
          setMessages((current) => [...current, { role: 'bmo', text: `Lembrete: ${next.text}` }])
          void postJson('/api/reminders', { action: 'notify', id: next.id })
          void playUiSound('ack')
          if (!next.backendFired) void speak(`Ei. Lembrete: ${next.text}`)
          return next
        })
      }
    } catch {
      // Reminder checks are best effort.
    }
  }

  async function refreshSubagents() {
    try {
      if (document.hidden) return
      const data = await getJson<{ items: SubagentItem[]; busy?: boolean }>('/api/subagents')
      if (!mountedRef.current) return
      if (data.busy) return
      const items = data.items || []
      setSubagents(items)
      if (!subagentsHydratedRef.current) {
        markExistingFinishedSubagentsSeen(items)
        subagentsHydratedRef.current = true
        return
      }
      for (const agent of items) {
        const finished = agent.status === 'concluido' || agent.status === 'erro'
        if (finished && !agent.notified && !notifiedSubagentsRef.current.has(agent.id)) {
          notifiedSubagentsRef.current.add(agent.id)
          persistNotifiedSubagents(notifiedSubagentsRef.current)
          const ok = agent.status === 'concluido'
          const result = typeof agent.result === 'object' && agent.result ? agent.result : null
          const summary = typeof result?.summary === 'string' ? result.summary : ''
          const outputPath = agent.outputFile || agent.outputPath || result?.outputPath || 'arquivo de resultado'
          const text = ok
            ? `${summary || `Agente #${agent.id} terminou.`} Resultado salvo em ${outputPath}.`
            : `Agente #${agent.id} encontrou um problema: ${agent.error || result?.error || 'erro desconhecido'}`
          setActiveNotification({ title: ok ? 'Subagente concluido' : 'Subagente com erro', text, kind: ok ? 'success' : 'error' })
          setMessages((current) => [...current, { role: 'bmo', text }])
          void postJson('/api/subagents', { action: 'mark_notified', id: agent.id })
          void playUiSound('ack')
          void speak(text)
        }
      }
    } catch {
      // Background agent status should not interrupt the chat.
    }
  }

  async function addSkill() {
    const data = await postJson<{ skills: SkillItem[] }>('/api/skills', { name: skillName, description: skillDescription })
    setSkills(data.skills || [])
    setSkillName('')
    setSkillDescription('')
    setStatus('Skill adicionada')
  }

  const onboardingScreens = [
    ['Oi! Eu sou o BMO', 'Seu assistente divertido para conversar, criar e resolver tarefas.'],
    ['Fale ou digite', 'Use o microfone ou o chat. Eu escuto, penso e respondo com voz.'],
    ['Eu posso ajudar', 'Arquivos, pesquisas, codigo, tarefas, memoria e ferramentas vao morar aqui.'],
    ['Primeira configuracao', 'Coloque sua chave API em Provedores para eu conseguir pensar online.'],
  ]

  const bottomStatus =
    bmoState === 'listening'
      ? `🎤 ${ui.statusByState.listening}`
      : bmoState === 'thinking'
        ? `🧠 ${ui.statusByState.thinking}`
        : bmoState === 'speaking'
          ? `🗣️ ${ui.statusByState.speaking}`
          : `🎤 ${ui.statusByState.idle}`

  return (
    <main className={`app-shell theme-${theme}`}>
      {dueReminder && (
        <div className="reminder-backdrop">
          <section className="reminder-popup">
            <img src={appIcon} alt="" />
            <div>
              <span>Lembrete do BMO</span>
              <h2>{dueReminder.text}</h2>
              <p>{new Date(dueReminder.dueAt * 1000).toLocaleString('pt-BR')}</p>
            </div>
            <div className="button-row">
              <button onClick={() => void snoozeReminder(5)}>Adiar 5 min</button>
              <button onClick={() => void snoozeReminder(10)}>Adiar 10 min</button>
              <button onClick={() => void completeReminder()}>Concluir</button>
            </div>
          </section>
        </div>
      )}
      {activeNotification && (
        <div className="notification-toast">
          <img src={appIcon} alt="" />
          <div>
            <span>{activeNotification.title}</span>
            <p>{activeNotification.text}</p>
          </div>
          <button onClick={() => setActiveNotification(null)}>OK</button>
        </div>
      )}
      {showOnboarding && (
        <div className="onboarding-backdrop">
          <section className="onboarding-card">
            <img src={appIcon} alt="BMO" />
            <span>Passo {onboardingStep + 1} de 4</span>
            <h2>{onboardingScreens[onboardingStep][0]}</h2>
            <p>{onboardingScreens[onboardingStep][1]}</p>
            {onboardingStep === 0 && (
              <input value={userName} placeholder="Como eu devo te chamar?" onChange={(event) => setUserName(event.target.value)} />
            )}
            <div className="button-row">
              {onboardingStep > 0 && <button onClick={() => setOnboardingStep((step) => step - 1)}>Voltar</button>}
              {onboardingStep < 3 ? (
                <button onClick={() => setOnboardingStep((step) => step + 1)}>Continuar</button>
              ) : (
                <button onClick={() => void finishOnboarding()}>Comecar</button>
              )}
            </div>
          </section>
        </div>
      )}
      <aside className={collapsed ? 'sidebar collapsed' : 'sidebar'}>
        <button className="brand" onClick={() => setCollapsed((value) => !value)}>
          <span className="brand-mark">
            <img src={appIcon} alt="" />
          </span>
          {!collapsed && (
            <span className="brand-copy">
              <strong>BMO</strong>
              <small>{ui.subtitle}</small>
            </span>
          )}
        </button>
        <nav className="nav-list">
          {navItems.map((item) => (
            <button
              className={activePanel === item.label ? 'nav-item active' : 'nav-item'}
              key={item.label}
              onClick={() => setActivePanel(item.label)}
              title={panelTitle(item.label)}
            >
              <item.icon size={20} />
              {!collapsed && <span>{panelTitle(item.label)}</span>}
            </button>
          ))}
        </nav>
        <button className="sidebar-status" onClick={() => void refreshAll()}>
          <span className={bmoState === 'idle' ? 'pulse-dot' : 'pulse-dot active'} />
          {!collapsed && (
            <span>
              {refreshing ? ui.updating : status}
              <small>BMO v1.0.0</small>
            </span>
          )}
        </button>
      </aside>

      {activePanel === 'Chat' ? (
        <section className="workspace chat-workspace">
          <header className="chat-header">
            <div className="chat-header-title">
              <h1>BMO</h1>
              <p className="clock-line">{clock.toLocaleDateString(language === 'en' ? 'en-US' : 'pt-BR')} • {clock.toLocaleTimeString(language === 'en' ? 'en-US' : 'pt-BR', { hour: '2-digit', minute: '2-digit' })}</p>
            </div>
            <button className="language-top-button" onClick={() => void changeLanguage(language === 'en' ? 'pt-BR' : 'en')} title={ui.languageToggle}>
              <Languages size={18} />
              {language === 'en' ? 'EN' : 'PT'}
            </button>
          </header>

          <main className="main-chat-view">
            <div className="content-grid">
              <section className="chat-panel">{renderPanel()}</section>
              <aside className="bmo-visual-panel" aria-label="BMO decorativo">
                <div className={`bmo-character state-${bmoState} chat-bmo-visual`}>
                  <div className="bmo-glow" />
                  <img className="bmo-body" src={bodyImage} alt="BMO" />
                  <div className="bmo-screen-face">
                    <img className="bmo-face" src={faceImage} alt="" />
                  </div>
                </div>
                {bmoState === 'thinking' && <div className="thinking-loader"><span /><span /><span /> {ui.thinking}</div>}
              </aside>
            </div>
          </main>

          <footer className="status-bar">
            <span>{bottomStatus}</span>
            <span>{clock.toLocaleDateString('pt-BR')} {clock.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })}</span>
            <span>{customModel || model}</span>
            <button className="status-toggle" onClick={() => void changeVoiceEnabled(!voiceEnabled)}>
              {voiceEnabled ? ui.voiceActive : ui.silentMode}
            </button>
          </footer>
        </section>
      ) : (
        <section className="workspace panel-workspace">
          <header className="topbar">
            <div>
              <h1>{panelTitle(activePanel)}</h1>
              <p className="clock-line">{clock.toLocaleDateString(language === 'en' ? 'en-US' : 'pt-BR')} • {clock.toLocaleTimeString(language === 'en' ? 'en-US' : 'pt-BR', { hour: '2-digit', minute: '2-digit' })}</p>
            </div>
            <button className="language-top-button" onClick={() => void changeLanguage(language === 'en' ? 'pt-BR' : 'en')} title={ui.languageToggle}>
              <Languages size={18} />
              {language === 'en' ? 'EN' : 'PT'}
            </button>
          </header>

          <section className="stage compact-stage">
            <div className={`bmo-character state-${bmoState}`}>
              <div className="bmo-glow" />
              <img className="bmo-body" src={bodyImage} alt="BMO" />
              <div className="bmo-screen-face">
                <img className="bmo-face" src={faceImage} alt="" />
              </div>
            </div>
            {bmoState === 'thinking' && <div className="thinking-loader"><span /><span /><span /> {ui.thinking}</div>}
          </section>

          <section className="content-shell">{renderPanel()}</section>
          <footer className="portable-status">
            <span>{bottomStatus}</span>
            <span>{clock.toLocaleDateString('pt-BR')} {clock.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })}</span>
            <span>{customModel || model}</span>
            <button className="status-toggle" onClick={() => void changeVoiceEnabled(!voiceEnabled)}>
              {voiceEnabled ? ui.voiceActive : ui.silentMode}
            </button>
          </footer>
        </section>
      )}
    </main>
  )
}

export default App
