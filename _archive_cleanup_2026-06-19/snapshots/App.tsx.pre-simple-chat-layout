  async function exportHistory(format: 'txt' | 'json' | 'md') {
    setHistoryExportOpen(false)
    const data = await postJson<{ ok: boolean; filename: string; content: string; mime: string; format: string }>('/api/history/export', {
      sessionId: null,
      format,
    })
    const extension = data.format === 'md' ? 'md' : data.format === 'json' ? 'json' : 'txt'
    const filters = [{ name: data.format === 'md' ? 'Markdown' : data.format.toUpperCase(), extensions: [extension] }]
    if (window.bmoDesktop?.saveFile) {
      const result = await window.bmoDesktop.saveFile({ defaultPath: data.filename, content: data.content, filters })
      if (result.ok) {
        setStatus(`Historico exportado: ${result.path || data.filename}`)
      } else if (result.error) {
        setStatus(result.error)
      }
      return
    }
    const blob = new Blob([data.content], { type: data.mime || 'text/plain' })
    const url = URL.createObjectURL(blob)
    const link = document.createElement('a')
    link.href = url
    link.download = data.filename
    link.click()
    URL.revokeObjectURL(url)
    setStatus(`Historico exportado: ${data.filename}`)
  }

