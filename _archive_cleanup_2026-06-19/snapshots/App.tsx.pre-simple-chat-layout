        getJson<LogsState>('/api/logs'),
        getJson<{ tools: ToolItem[] }>('/api/tools'),
        getJson<{ channels: ChannelItem[] }>('/api/channels'),
        getJson<{ voices: VoiceModel[]; selected?: string }>('/api/voices'),
        getJson<{ skills: SkillItem[] }>('/api/skills'),
        getJson<{ items: SubagentItem[]; busy?: boolean }>('/api/subagents'),
        getJson<{ items: TaskItem[] }>('/api/tasks'),
      ])
      if (!mountedRef.current) return
      setSettings(settingsData)
      if (!systemData.busy) setSystem(systemData)
      setMemories(memoryData.items || [])
      const loadedHistory = historyData.sessions || []
      setHistory(loadedHistory)
      const storedSessionId = localStorage.getItem('bmo-active-session-id')
      const restoredSession =
        (storedSessionId && loadedHistory.find((session) => session.id === storedSessionId)) ||
        (activeSessionId && loadedHistory.find((session) => session.id === activeSessionId)) ||
        null
      const canRestoreMessages =
        messages.length === 1 &&
        messages[0]?.role === 'bmo' &&
        (messages[0]?.text.includes('Ola!') || messages[0]?.text.includes('Olá!') || messages[0]?.text.includes('Nova conversa'))
      if (restoredSession && canRestoreMessages) {
        rememberActiveSession(restoredSession.id)
        setMessages(restoredSession.messages?.length ? restoredSession.messages : [{ role: 'bmo', text: 'Conversa reaberta.' }])
      }
      setLogs(logsData)
      setTools(toolsData.tools || [])
      setChannels(channelsData.channels || [])
      // Extrair hints dos canais (back-end fornece hints ou vazio)
      const hintsMap: Record<string, string[]> = {}
      for (const ch of channelsData.channels || []) {
        if ((ch as any).hints) hintsMap[ch.id] = (ch as any).hints
      }
      setChannelHints(hintsMap)
      setVoiceModels(voicesData.voices || [])
      setSkills(skillsData.skills || [])
      if (!subagentsData.busy) {
        const initialSubagents = subagentsData.items || []
        setSubagents(initialSubagents)
        markExistingFinishedSubagentsSeen(initialSubagents)
        subagentsHydratedRef.current = true
      }
      setTasks(tasksData.items || [])
      setLastError('')
      if (settingsData.nanobot?.provider) setProvider(settingsData.nanobot.provider)
      if (settingsData.nanobot?.model) {
        setModel(settingsData.nanobot.model)
        setCustomModel(settingsData.nanobot.model)
      }
      if (typeof settingsData.nanobot?.temperature === 'number') setTemperature(settingsData.nanobot.temperature)
      if (typeof settingsData.nanobot?.maxTokens === 'number') setMaxTokens(settingsData.nanobot.maxTokens)
      if (typeof settingsData.nanobot?.contextWindowTokens === 'number') setContextWindowTokens(settingsData.nanobot.contextWindowTokens)
      if (settingsData.nanobot?.reasoningEffort) setReasoningEffort(settingsData.nanobot.reasoningEffort)
      if (settingsData.app?.voice?.model) setVoiceModel(settingsData.app.voice.model)
      if (typeof settingsData.app?.voice?.enabled === 'boolean') setVoiceEnabled(settingsData.app.voice.enabled)
      if (settingsData.app?.language) setLanguage(settingsData.app.language)
      if (typeof settingsData.app?.startWithWindows === 'boolean') setStartWithWindows(settingsData.app.startWithWindows)
      if (settingsData.app?.hotkey) setHotkey(settingsData.app.hotkey)
      if (typeof settingsData.app?.chatFontScale === 'number') setChatFontScale(settingsData.app.chatFontScale)
      if (settingsData.app?.theme && ['cartoon', 'dark', 'soft', 'led', 'bmo-face', 'treehouse', 'night-forest'].includes(settingsData.app.theme)) setTheme(settingsData.app.theme)
      if (settingsData.app?.userName) setUserName(settingsData.app.userName)
      if (typeof settingsData.whisper?.gpu_enabled === 'boolean') setWhisperGpuEnabled(settingsData.whisper.gpu_enabled)
      if (settingsData.whisper?.model && ['tiny', 'base', 'small'].includes(settingsData.whisper.model)) setWhisperModelChoice(settingsData.whisper.model)
      if (!settingsData.app?.onboardingComplete) setShowOnboarding(true)
      const selectedProvider = settingsData.nanobot?.provider || provider
      setApiBase(settingsData.providers?.[selectedProvider]?.apiBase || '')
    } catch (error) {
      if (!mountedRef.current) return
      const message = error instanceof Error ? error.message : 'Falha ao carregar configuracoes'
      setLastError(message)
      setStatus(message)
    } finally {
      if (mountedRef.current) {
        setRefreshing(false)
        setBooting(false)
        if (!startupSoundPlayedRef.current) {
          startupSoundPlayedRef.current = true
          window.setTimeout(() => void playUiSound('startup'), 350)
        }
      }
    }
  }

