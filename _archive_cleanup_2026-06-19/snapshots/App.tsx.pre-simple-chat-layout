const NOTIFIED_SUBAGENTS_STORAGE_KEY = 'bmo-notified-subagents'

function loadNotifiedSubagents() {
  try {
    const raw = localStorage.getItem(NOTIFIED_SUBAGENTS_STORAGE_KEY)
    const ids = raw ? JSON.parse(raw) : []
    return new Set<string>(Array.isArray(ids) ? ids.filter((id) => typeof id === 'string') : [])
  } catch {
    return new Set<string>()
  }
}

function persistNotifiedSubagents(ids: Set<string>) {
  try {
    localStorage.setItem(NOTIFIED_SUBAGENTS_STORAGE_KEY, JSON.stringify([...ids].slice(-200)))
  } catch {
    // Local persistence is only a guard against duplicate notifications.
  }
}

function friendlyErrorMessage(raw: string) {
  const text = raw.toLowerCase()
  if (text.includes('no api key') || text.includes('provider none') || text.includes('chave') || text.includes('401') || text.includes('user not found')) {
    return 'Ops! Minha chavinha de acesso nao esta pronta. Cole uma chave do OpenRouter em Provedores e eu volto a conversar rapidinho.'
  }
  if (text.includes('503') || text.includes('no healthy upstream')) {
    return 'O modelo deu uma cochilada agora. Eu posso tentar de novo em alguns segundos ou voce pode escolher outro modelo.'
  }
  if (text.includes('internet') || text.includes('network') || text.includes('fetch')) {
    return 'A internet parece ter piscado. Eu fiquei aqui segurando o controle, mas nao consegui falar com o modelo.'
  }
  return `Ops, eu tropecei nessa resposta. ${raw.split('\n')[0]}`
}

