/* User theme pack: keep Cartoon uniform and add the three supplied backgrounds. */
.theme-cartoon {
  --bg: #34c7b8;
  --panel: rgba(7, 102, 93, 0.5);
  --panel-2: rgba(5, 88, 80, 0.55);
  --accent: #bfffd7;
  --accent-2: #ebfff3;
  --accent-soft: rgba(191, 255, 215, 0.24);
  --text: #f7fff9;
  --muted: rgba(240, 255, 247, 0.78);
  --border: rgba(239, 255, 247, 0.26);
}

.theme-cartoon .workspace {
  background: #34c7b8 !important;
}

.theme-cartoon .workspace::before {
  content: "";
  background:
    radial-gradient(circle at 50% 36%, rgba(225, 255, 238, 0.22), transparent 31%),
    radial-gradient(circle at 76% 54%, rgba(16, 137, 125, 0.12), transparent 28%);
  opacity: 1;
}

.theme-cartoon .workspace::after {
  background:
    radial-gradient(circle, rgba(245, 255, 248, 0.15), rgba(191, 255, 215, 0.08) 38%, transparent 68%);
  filter: blur(30px);
}

.theme-cartoon .topbar {
  background: transparent;
  border-bottom-color: rgba(255, 255, 255, 0.16);
}

.theme-bmo-face,
.theme-treehouse,
.theme-night-forest {
  --panel: rgba(0, 40, 30, 0.55);
  --panel-2: rgba(3, 82, 62, 0.45);
  --accent: #39ff8f;
  --accent-2: #b9ffd4;
  --accent-soft: rgba(57, 255, 143, 0.18);
  --text: #f2fff7;
  --muted: rgba(221, 255, 232, 0.76);
  --border: rgba(57, 255, 143, 0.24);
}

.theme-bmo-face {
  --bg: #78cdb0;
}

.theme-treehouse {
  --bg: #103b2e;
  --accent: #7bff61;
  --accent-2: #d7ffc8;
  --accent-soft: rgba(123, 255, 97, 0.18);
  --border: rgba(123, 255, 97, 0.24);
}

.theme-night-forest {
  --bg: #06162c;
  --panel: rgba(4, 22, 36, 0.58);
  --panel-2: rgba(9, 48, 68, 0.5);
  --accent: #79e8ff;
  --accent-2: #c3f7ff;
  --accent-soft: rgba(121, 232, 255, 0.17);
  --border: rgba(121, 232, 255, 0.23);
}

.theme-bmo-face .workspace,
.theme-treehouse .workspace,
.theme-night-forest .workspace {
  background:
    radial-gradient(circle at 52% 42%, color-mix(in srgb, var(--accent) 20%, transparent), transparent 31%),
    linear-gradient(145deg, color-mix(in srgb, var(--bg) 82%, #00110c), color-mix(in srgb, var(--bg) 52%, #000907));
}

.theme-bmo-face .workspace::before,
.theme-treehouse .workspace::before,
.theme-night-forest .workspace::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  opacity: 0.24;
  filter: saturate(1.08) contrast(1.03);
  pointer-events: none;
}

.theme-bmo-face .workspace::before {
  background-image:
    linear-gradient(90deg, rgba(19, 113, 93, 0.46), rgba(53, 199, 184, 0.18), rgba(19, 113, 93, 0.46)),
    url("./assets/bmo/theme-cartoon-face.jpg");
  opacity: 0.22;
}

.theme-treehouse .workspace::before {
  background-image:
    linear-gradient(90deg, rgba(1, 27, 20, 0.62), rgba(6, 59, 39, 0.12), rgba(1, 27, 20, 0.66)),
    url("./assets/bmo/theme-treehouse-day.jpg");
  opacity: 0.28;
}

.theme-night-forest .workspace::before {
  background-image:
    linear-gradient(90deg, rgba(1, 10, 25, 0.5), rgba(4, 22, 36, 0.2), rgba(1, 10, 25, 0.58)),
    url("./assets/bmo/theme-night-forest.jpg");
  opacity: 0.34;
}

.theme-bmo-face .workspace::after,
.theme-treehouse .workspace::after,
.theme-night-forest .workspace::after {
  content: "";
  position: absolute;
  left: 22%;
  top: 7%;
  width: 58%;
  height: 58%;
  z-index: 0;
  border-radius: 50%;
  background: radial-gradient(circle, color-mix(in srgb, var(--accent) 28%, transparent), transparent 68%);
  filter: blur(34px);
  pointer-events: none;
}

.theme-bmo-face .sidebar,
.theme-bmo-face .chat-area,
.theme-bmo-face .config-card,
.theme-bmo-face .portable-status,
.theme-treehouse .sidebar,
.theme-treehouse .chat-area,
.theme-treehouse .config-card,
.theme-treehouse .portable-status,
.theme-night-forest .sidebar,
.theme-night-forest .chat-area,
.theme-night-forest .config-card,
.theme-night-forest .portable-status {
  border-color: var(--border);
  background: var(--panel);
  box-shadow:
    0 18px 50px rgba(0, 0, 0, 0.28),
    0 0 28px color-mix(in srgb, var(--accent) 12%, transparent);
  backdrop-filter: blur(12px);
}

/* Background clarity pass: wallpapers stay sharp; glass remains only on UI components. */
.theme-led .workspace,
.theme-cartoon .workspace,
.theme-bmo-face .workspace,
.theme-treehouse .workspace,
.theme-night-forest .workspace {
  background: var(--bg) !important;
}

.theme-led .workspace::before,
.theme-cartoon .workspace::before,
.theme-bmo-face .workspace::before,
.theme-treehouse .workspace::before,
.theme-night-forest .workspace::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  opacity: 1;
  filter: none;
  transform: none;
  animation: none;
  pointer-events: none;
}

.theme-led .workspace::before {
  background-image: url("./assets/bmo/bmo-quarto.png") !important;
}

.theme-cartoon .workspace::before,
.theme-bmo-face .workspace::before {
  background-image: url("./assets/bmo/theme-cartoon-face.jpg") !important;
}

.theme-treehouse .workspace::before {
  background-image: url("./assets/bmo/theme-treehouse-day.jpg") !important;
}

.theme-night-forest .workspace::before {
  background-image: url("./assets/bmo/theme-night-forest.jpg") !important;
}

.theme-led .workspace::after,
.theme-cartoon .workspace::after,
.theme-bmo-face .workspace::after,
.theme-treehouse .workspace::after,
.theme-night-forest .workspace::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  width: auto;
  height: auto;
  border-radius: 0;
  background:
    linear-gradient(90deg, rgba(0, 10, 8, 0.12), transparent 34%, transparent 66%, rgba(0, 10, 8, 0.12)),
    radial-gradient(circle at 52% 36%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 28%);
  filter: none;
  pointer-events: none;
}

.theme-night-forest .workspace::after {
  background:
    linear-gradient(90deg, rgba(0, 5, 18, 0.1), transparent 36%, transparent 66%, rgba(0, 5, 18, 0.1)),
    radial-gradient(circle at 52% 38%, rgba(121, 232, 255, 0.1), transparent 26%);
}

.sidebar,
.chat-area,
.config-card,
.portable-status {
  backdrop-filter: blur(10px);
}

/* Final UX fixes: stronger character presence, responsive panels and accessible chat. */






.compact-stage 

