.app-shell {
  width: 100vw;
  height: 100vh;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  color: #ecfff5;
  overflow: hidden;
  background:
    radial-gradient(circle at 54% 44%, rgba(19, 179, 102, 0.26), transparent 32%),
    radial-gradient(circle at 78% 18%, rgba(57, 217, 138, 0.09), transparent 25%),
    linear-gradient(145deg, #020b0c, #061917 58%, #020707);
}

.splash-screen {
  width: 100vw;
  height: 100vh;
  display: grid;
  place-content: center;
  justify-items: center;
  gap: 14px;
  color: #ecfff5;
  background:
    radial-gradient(circle at center, rgba(57, 217, 138, 0.24), transparent 34%),
    linear-gradient(145deg, #020b0c, #061917 58%, #020707);
}

.splash-screen img {
  width: 112px;
  height: 112px;
  object-fit: contain;
  filter: drop-shadow(0 0 34px rgba(57, 217, 138, 0.38));
}

.splash-screen p {
  margin: 0;
  color: #9eecc0;
}

.loading-bars,
.thinking-loader {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: #bfffd2;
  font-weight: 650;
}

.loading-bars span,
.thinking-loader span {
  width: 7px;
  height: 22px;
  border-radius: 999px;
  background: var(--accent, #39d98a);
  animation: voiceBars 760ms ease-in-out infinite;
}

.loading-bars span:nth-child(2),
.thinking-loader span:nth-child(2) {
  animation-delay: 120ms;
}

.loading-bars span:nth-child(3),
.thinking-loader span:nth-child(3) {
  animation-delay: 240ms;
}

.onboarding-backdrop {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: grid;
  place-items: center;
  padding: 24px;
  background: rgba(1, 8, 7, 0.78);
  backdrop-filter: blur(18px);
}

.onboarding-card {
  width: min(460px, 100%);
  display: grid;
  gap: 14px;
  padding: 28px;
  border: 1px solid rgba(110, 231, 183, 0.22);
  border-radius: 28px;
  background: linear-gradient(180deg, rgba(8, 42, 37, 0.94), rgba(3, 18, 17, 0.94));
  box-shadow: 0 32px 110px rgba(0, 0, 0, 0.44);
}

.onboarding-card img {
  width: 82px;
  height: 82px;
  object-fit: contain;
}

.onboarding-card span,
.onboarding-card p {
  color: var(--muted);
}

.onboarding-card h2 {
  margin: 0;
  font-size: 28px;
}

.onboarding-card input {
  min-height: 48px;
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 0 14px;
  color: var(--text);
  background: rgba(3, 18, 17, 0.75);
}

.theme-dark {
  --bg: #071412;
  --panel: #0b1f1b;
  --panel-2: #10352f;
  --accent: #39d98a;
  --accent-soft: rgba(57, 217, 138, 0.15);
  --text: #ecfff5;
  --muted: #8fb8a9;
  --border: rgba(110, 231, 183, 0.16);
}

.theme-soft {
  --bg: #0b1f1b;
  --panel: #102c27;
  --panel-2: #153e36;
  --accent: #6ee7b7;
  --accent-soft: rgba(110, 231, 183, 0.16);
  --text: #f4fff8;
  --muted: #a6d6c4;
  --border: rgba(186, 255, 201, 0.18);
}

.theme-cartoon {
  --bg: #32bdae;
  --panel: rgba(10, 132, 119, 0.52);
  --panel-2: rgba(9, 102, 92, 0.58);
  --accent: #7cffbd;
  --accent-soft: rgba(124, 255, 189, 0.22);
  --text: #f5fff9;
  --muted: rgba(224, 255, 240, 0.74);
  --border: rgba(209, 255, 232, 0.24);
  background:
    radial-gradient(circle at 50% 37%, rgba(198, 255, 224, 0.24), transparent 26%),
    radial-gradient(circle at 18% 18%, rgba(151, 255, 218, 0.18), transparent 18%),
    linear-gradient(145deg, #1da999, #35bfae 48%, #169684);
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  border: 0;
  cursor: pointer;
}

.sidebar {
  width: 252px;
  min-height: 0;
  background: linear-gradient(180deg, rgba(4, 16, 15, 0.92), rgba(8, 33, 30, 0.82));
  color: var(--text);
  padding: 18px 14px;
  display: flex;
  flex-direction: column;
  gap: 18px;
  border-right: 1px solid var(--border);
  box-shadow: 18px 0 70px rgba(0, 0, 0, 0.24);
  transition: width 240ms ease;
  backdrop-filter: blur(16px);
}

.theme-cartoon .sidebar {
  background: linear-gradient(180deg, rgba(5, 82, 76, 0.58), rgba(2, 68, 64, 0.4));
  border-right-color: rgba(214, 255, 237, 0.2);
  box-shadow: 18px 0 70px rgba(4, 84, 75, 0.18);
}

.sidebar.collapsed {
  width: 78px;
}

.brand {
  min-height: 84px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px;
  border-radius: 20px;
  color: var(--text);
  background: transparent;
  font-weight: 650;
  text-align: left;
}

.brand:hover,
.nav-item:hover,
.sidebar-status:hover {
  background: rgba(110, 231, 183, 0.1);
}

.brand-mark {
  width: 64px;
  height: 64px;
  border-radius: 16px;
  display: grid;
  place-items: center;
  overflow: hidden;
  background: linear-gradient(145deg, rgba(129, 255, 192, 0.92), rgba(28, 93, 82, 0.74));
  color: #05201c;
  font-weight: 800;
  box-shadow: 0 0 26px rgba(57, 217, 138, 0.32);
}

.brand-mark img {
  width: 118%;
  height: 118%;
  object-fit: contain;
}

.brand-copy {
  display: grid;
  gap: 4px;
}

.brand-copy strong {
  font-size: 19px;
}

.brand-copy small {
  color: var(--muted);
  font-size: 12px;
  font-weight: 500;
}

.nav-list {
  display: grid;
  gap: 8px;
  overflow: auto;
  padding-right: 2px;
}

.nav-item {
  height: 48px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 14px;
  border-radius: 15px;
  background: transparent;
  color: #9eecc0;
  font-weight: 520;
  transition:
    background 220ms ease,
    color 220ms ease,
    transform 220ms ease,
    box-shadow 220ms ease;
}

.theme-cartoon .nav-item {
  color: rgba(240, 255, 248, 0.88);
}

.theme-cartoon .nav-item.active {
  background: rgba(226, 255, 239, 0.13);
  box-shadow: inset 0 0 0 1px rgba(232, 255, 243, 0.22);
}

.nav-item.active {
  color: #ffffff;
  background: rgba(57, 217, 138, 0.16);
  box-shadow: inset 0 0 0 1px rgba(110, 231, 183, 0.16);
}

.nav-item:hover {
  color: #ffffff;
  transform: translateX(2px);
}

.sidebar.collapsed .nav-item,
.sidebar.collapsed .brand,
.sidebar.collapsed .sidebar-status {
  justify-content: center;
  padding-inline: 0;
}

.sidebar-status {
  margin-top: auto;
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 46px;
  border-radius: 14px;
  padding: 0 12px;
  background: rgba(57, 217, 138, 0.08);
  color: #c9ffe1;
  font-size: 13px;
  font-weight: 550;
}

.sidebar-status > span:last-child {
  display: grid;
  gap: 3px;
  text-align: left;
}

.sidebar-status small {
  color: var(--muted);
  font-size: 11px;
  font-weight: 500;
}

.pulse-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 16px var(--accent);
}

.pulse-dot.active {
  animation: pulse 1s ease-in-out infinite;
}

.workspace {
  min-width: 0;
  min-height: 0;
  position: relative;
  display: grid;
  background:
    radial-gradient(circle at 50% 43%, rgba(37, 207, 119, 0.28), transparent 32%),
    radial-gradient(circle at 50% 58%, rgba(44, 255, 150, 0.08), transparent 22%),
    linear-gradient(145deg, rgba(2, 11, 12, 0.4), rgba(6, 25, 23, 0.4) 58%, rgba(2, 7, 7, 0.45));
  overflow: hidden;
}

.theme-cartoon .workspace {
  background:
    radial-gradient(circle at 50% 42%, rgba(211, 255, 232, 0.32), transparent 27%),
    radial-gradient(circle at 70% 80%, rgba(10, 112, 100, 0.18), transparent 25%),
    linear-gradient(145deg, rgba(55, 193, 177, 0.92), rgba(38, 180, 165, 0.92));
}

.theme-cartoon .workspace::before {
  content: "♡  ✦  □  ♪  ◇  #  ♡  ✧  ○  □  ♪";
  position: absolute;
  inset: 0;
  z-index: 0;
  color: rgba(228, 255, 244, 0.16);
  font-size: clamp(22px, 2vw, 34px);
  word-spacing: 72px;
  line-height: 5.8;
  transform: rotate(-6deg) translateY(-4%);
  pointer-events: none;
  user-select: none;
}

.workspace > * {
  position: relative;
  z-index: 1;
}

/* ============================================================== */
/* CHAT WORKSPACE — BMO grande + chat fixo na parte inferior     */
/* ============================================================== */
.chat-workspace {
  display: grid;
  grid-template-rows: auto 1fr auto auto;
  overflow: hidden;
  height: 100%;
}

.chat-workspace > .topbar {
  min-height: 78px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22px;
  padding: 18px 38px 2px;
  border-bottom: 1px solid color-mix(in srgb, var(--accent) 18%, transparent);
  background: linear-gradient(180deg, color-mix(in srgb, var(--panel) 56%, transparent), transparent);
}

.chat-workspace > .stage {
  min-height: 0;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 28px;
  overflow: hidden;
}

.chat-workspace > .content-shell {
  min-height: 0;
  overflow: visible;
  padding: 0 34px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.chat-workspace > .portable-status {
  position: static;
  min-height: 56px;
  max-height: 64px;
  display: grid;
  grid-template-columns: 1.4fr repeat(3, minmax(90px, 1fr));
  gap: 8px;
  margin: 0 34px 8px;
  padding: 6px 10px;
  border: 1px solid rgba(235, 255, 244, 0.22);
  border-radius: 18px;
  background: rgba(4, 104, 95, 0.34);
  backdrop-filter: blur(18px);
}

/* Chat area dentro do content-shell */
.chat-area {
  width: min(980px, calc(100% - 68px));
  justify-self: center;
  margin: 0 auto 0;
  padding: 16px 18px 14px;
  max-height: min(35vh, 360px);
  min-height: 200px;
  display: flex;
  flex-direction: column;
  border: 1px solid var(--border);
  border-radius: 26px;
  background: rgba(4, 92, 84, 0.45);
  box-shadow: 0 24px 70px rgba(4, 84, 75, 0.24);
  backdrop-filter: blur(18px);
}

.chat-area .messages {
  flex: 1 1 auto;
  overflow-y: auto;
  min-height: 0;
  scrollbar-width: thin;
  scrollbar-color: rgba(110, 231, 183, 0.3) transparent;
}

.chat-area .composer {
  flex-shrink: 0;
  margin-top: 6px;
  padding-top: 6px;
  border-top: 1px solid rgba(110, 231, 183, 0.12);
}

.chat-area .quick-actions {
  flex-shrink: 0;
  display: flex;
  gap: 6px;
  padding: 4px 0;
  overflow-x: auto;
}

.panel-workspace {
  grid-template-rows: auto minmax(170px, 0.34fr) minmax(0, 1fr);
}

.topbar {
  min-height: 78px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22px;
  padding: 18px 38px 2px;
  border-bottom: 1px solid color-mix(in srgb, var(--accent) 18%, transparent);
  background: linear-gradient(180deg, color-mix(in srgb, var(--panel) 56%, transparent), transparent);
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.clock-line {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: 13px;
  font-weight: 600;
}

.global-status {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px;
  border: 1px solid rgba(110, 231, 183, 0.12);
  border-radius: 22px;
  background: rgba(3, 18, 17, 0.52);
  box-shadow: 0 18px 55px rgba(0, 0, 0, 0.22);
  backdrop-filter: blur(18px);
}

.eyebrow {
  margin: 0 0 4px;
  font-size: 12px;
  font-weight: 650;
  text-transform: uppercase;
  color: var(--accent);
  letter-spacing: 0.08em;
}

h1 {
  margin: 0;
  font-size: clamp(20px, 2vw, 28px);
  font-weight: 620;
  letter-spacing: 0;
  line-height: 1.1;
  color: var(--text);
}

.icon-button {
  width: 56px;
  height: 56px;
  border-radius: 18px;
  display: grid;
  place-items: center;
  color: #bfffd2;
  background: rgba(7, 61, 58, 0.86);
  box-shadow: 0 18px 45px rgba(0, 0, 0, 0.28);
  transition:
    transform 200ms ease,
    background 200ms ease;
}

.theme-cartoon .icon-button {
  background: rgba(5, 112, 102, 0.42);
  color: #eafff1;
  border: 1px solid rgba(233, 255, 243, 0.18);
}

.icon-button:hover {
  background: #0c514a;
  transform: translateY(-1px);
}



.thinking-loader {
  position: absolute;
  bottom: 10px;
  padding: 10px 14px;
  border: 1px solid rgba(110, 231, 183, 0.16);
  border-radius: 999px;
  background: rgba(3, 18, 17, 0.72);
  box-shadow: 0 18px 55px rgba(0, 0, 0, 0.28);
}



.compact-stage 

.compact-stage .speech-card {
  display: none;
}

.bmo-character {
  position: relative;
  width: 100%;
  max-width: min(560px, 52vw, 58vh);
  min-width: 0;
  aspect-ratio: 798 / 750;
  display: grid;
  place-items: center;
}

.bmo-glow {
  position: absolute;
  width: 68%;
  height: 70%;
  border-radius: 50%;
  background: rgba(57, 217, 138, 0.18);
  filter: blur(34px);
  transform: translateY(10%);
}

.theme-cartoon .bmo-glow {
  background: rgba(215, 255, 231, 0.28);
  filter: blur(42px);
}

.bmo-body {
  position: absolute;
  width: 100%;
  height: 100%;
  object-fit: contain;
  filter: drop-shadow(0 30px 32px rgba(0, 0, 0, 0.38));
}

.bmo-screen-face {
  position: absolute;
  left: 31.9%;
  top: 10.1%;
  width: 46.2%;
  height: 37.3%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 11%;
  z-index: 3;
  background: #baffd3;
}

.bmo-face {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.96;
  mix-blend-mode: normal;
}

.state-speaking .bmo-face,
.state-listening .bmo-face {
  filter: drop-shadow(0 0 8px rgba(57, 217, 138, 0.2));
}

.content-shell {
  min-height: 0;
  overflow: auto;
  padding: 0 34px clamp(90px, 12vh, 122px);
  scrollbar-color: rgba(110, 231, 183, 0.35) transparent;
}

.chat-shell {
  display: grid;
  align-items: end;
  overflow: hidden;
}

.panel-workspace .content-shell {
  overflow: auto;
  padding-top: 8px;
}



.theme-cartoon .chat-area,
.theme-cartoon .config-card {
  border-color: rgba(235, 255, 244, 0.24);
  background: rgba(4, 100, 91, 0.36);
  box-shadow: 0 24px 70px rgba(4, 84, 75, 0.18);
}

.panel-grid {
  width: min(1180px, 100%);
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(2, minmax(260px, 1fr));
  gap: 16px;
  padding-bottom: 8px;
}

.config-card {
  min-height: 190px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 18px;
  border: 1px solid var(--border);
  border-radius: 24px;
  background: rgba(7, 39, 35, 0.74);
  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.24);
}

.config-card.wide {
  grid-column: 1 / -1;
}

.config-card h2 {
  margin: 0;
  font-size: 18px;
  font-weight: 620;
}

.config-card p,
.muted {
  color: var(--muted);
  font-size: 14px;
}

.config-card label {
  display: grid;
  gap: 7px;
  color: #c8f8d4;
  font-size: 14px;
  font-weight: 520;
}

.config-card input,
.config-card select {
  width: 100%;
  min-height: 44px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: #102f2b;
  color: #e9fff2;
  padding: 0 12px;
  outline: none;
}

.theme-cartoon .config-card input,
.theme-cartoon .config-card select,
.theme-cartoon .composer {
  background: rgba(3, 96, 88, 0.42);
  border-color: rgba(232, 255, 242, 0.22);
}

.config-card button,
.button-row button {
  min-height: 40px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: 14px;
  background: rgba(57, 217, 138, 0.14);
  color: #eafff0;
  padding: 0 14px;
  font-weight: 580;
}

.config-card button:disabled,
.button-row button:disabled,
.composer button:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

.config-card button:hover,
.button-row button:hover {
  background: rgba(57, 217, 138, 0.22);
}

.connection-result {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  width: fit-content;
  max-width: 100%;
  padding: 10px 12px;
  border-radius: 14px;
  font-weight: 650;
  overflow-wrap: anywhere;
}

.connection-result.ok {
  color: #caffda;
  background: rgba(57, 217, 138, 0.13);
  border: 1px solid rgba(57, 217, 138, 0.28);
}

.connection-result.error {
  color: #ffd4d4;
  background: rgba(255, 99, 99, 0.12);
  border: 1px solid rgba(255, 99, 99, 0.22);
}

.log-box {
  max-height: 260px;
  overflow: auto;
  white-space: pre-wrap;
  word-break: break-word;
  padding: 14px;
  border-radius: 14px;
  border: 1px solid rgba(110, 231, 183, 0.14);
  background: rgba(1, 8, 7, 0.56);
  color: rgba(220, 255, 239, 0.82);
  font: 12px/1.5 Consolas, 'Cascadia Mono', monospace;
}

.spin {
  animation: spin 900ms linear infinite;
}

.field-row {
  display: grid;
  grid-template-columns: minmax(160px, 0.7fr) minmax(240px, 1.3fr);
  gap: 14px;
}

.button-row,
.status-list {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.status-pill,
.dev-tag {
  width: fit-content;
  display: inline-flex;
  align-items: center;
  min-height: 30px;
  border-radius: 999px;
  padding: 0 12px;
  color: #ffd0d0;
  background: rgba(255, 99, 99, 0.12);
  border: 1px solid rgba(255, 99, 99, 0.18);
  font-size: 12px;
  font-weight: 650;
}

.status-pill.ok {
  color: #bfffd2;
  background: rgba(57, 217, 138, 0.13);
  border-color: rgba(57, 217, 138, 0.2);
}

.dev-tag {
  color: #ffe5a3;
  background: rgba(255, 198, 77, 0.12);
  border-color: rgba(255, 198, 77, 0.18);
}

.list-stack {
  display: grid;
  gap: 10px;
}

.list-item {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 12px;
  border-radius: 16px;
  padding: 12px;
  background: rgba(3, 18, 17, 0.5);
}

.list-item.active {
  border: 1px solid rgba(57, 217, 138, 0.32);
  background: rgba(57, 217, 138, 0.1);
}

.list-main {
  display: grid;
  gap: 4px;
  color: inherit;
  background: transparent;
  text-align: left;
  padding: 0;
}

.list-main strong {
  color: #ecfff5;
}

.list-main span {
  color: var(--muted);
  font-size: 12px;
}

.list-main p {
  margin: 0;
  color: var(--muted);
}

.panel-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18px;
}

.history-actions {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10px;
}

.export-menu {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  z-index: 20;
  display: grid;
  min-width: 150px;
  gap: 6px;
  padding: 8px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: rgba(3, 24, 20, 0.96);
  box-shadow: 0 18px 45px rgba(0, 0, 0, 0.28);
}

.export-menu button {
  justify-content: flex-start;
  min-height: 34px;
}

.history-list {
  margin-top: 12px;
}

.path-list {
  display: grid;
  gap: 9px;
}

.path-list p {
  display: grid;
  gap: 2px;
  margin: 0;
  color: var(--muted);
  overflow-wrap: anywhere;
}

.path-list button {
  width: fit-content;
  min-height: 30px;
  margin-top: 4px;
  border-radius: 10px;
  padding: 0 10px;
}

.path-list strong {
  color: #dfffea;
}

.messages {
  min-height: 0;
  flex: 1 1 auto;
  max-height: none;
  overflow: auto;
  display: grid;
  gap: 10px;
  padding: 0 2px 12px;
  scrollbar-color: rgba(110, 231, 183, 0.35) transparent;
}

.messages::-webkit-scrollbar,
.content-shell::-webkit-scrollbar,
.nav-list::-webkit-scrollbar {
  width: 9px;
}

.messages::-webkit-scrollbar-thumb,
.content-shell::-webkit-scrollbar-thumb,
.nav-list::-webkit-scrollbar-thumb {
  border-radius: 999px;
  background: rgba(110, 231, 183, 0.32);
}

.message {
  display: grid;
  gap: 3px;
  text-align: left;
}

.message span {
  color: #9eecc0;
  font-size: 12px;
  font-weight: 650;
}

.message p {
  margin: 0;
  color: #ecfff5;
  line-height: 1.42;
  font-size: 14px;
  overflow-wrap: anywhere;
  white-space: pre-line;
}

.attachment-preview,
.pending-attachment {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 8px 0;
  padding: 8px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.06);
}

.attachment-preview {
  width: fit-content;
  max-width: min(320px, 100%);
  flex-direction: column;
  align-items: flex-start;
}

.attachment-preview img {
  width: min(280px, 100%);
  max-height: 190px;
  object-fit: cover;
  border-radius: 14px;
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.24);
}

.file-preview {
  width: 62px;
  height: 52px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: rgba(124, 255, 189, 0.12);
  color: var(--accent);
}

.attachment-preview figcaption,
.pending-attachment span {
  color: var(--muted);
  font-size: 12px;
}

.pending-attachment {
  margin-top: 10px;
}

.pending-attachment img {
  width: 74px;
  height: 54px;
  object-fit: cover;
  border-radius: 12px;
}

.pending-attachment button {
  margin-left: auto;
  min-height: 32px;
  padding: 0 12px;
  border-radius: 12px;
}

.progress-track {
  width: 100%;
  height: 8px;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.09);
}

.progress-track i {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--accent), var(--accent-2));
  box-shadow: 0 0 18px rgba(61, 255, 138, 0.34);
}

.subagent-item .list-main {
  display: grid;
  gap: 6px;
}

.message.user p {
  color: #c7ffdb;
}

.quick-actions {
  flex: 0 0 auto;
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 12px;
}

.quick-actions button {
  min-height: 38px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 0 14px;
  border-radius: 13px;
  background: rgba(57, 217, 138, 0.12);
  color: #dcffe9;
  font-size: 14px;
  font-weight: 560;
  transition: background 200ms ease, transform 200ms ease;
}

.quick-actions button:hover {
  background: rgba(57, 217, 138, 0.2);
  transform: translateY(-1px);
}

.composer {
  flex: 0 0 auto;
  min-height: 68px;
  display: grid;
  grid-template-columns: auto auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 8px;
  padding: 8px;
  border-radius: 22px;
  background: rgba(3, 18, 17, 0.9);
  box-shadow: inset 0 0 0 1px rgba(110, 231, 183, 0.08);
}

.theme-cartoon .composer .send-button {
  background: linear-gradient(145deg, #96ffd0, #3beaa4);
  color: #06433c;
  box-shadow: 0 14px 34px rgba(31, 208, 149, 0.28);
}

.composer.compact {
  grid-template-columns: auto minmax(0, 1fr) auto;
  background: rgba(3, 18, 17, 0.7);
}

.composer button {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: transparent;
  color: #9ef4c0;
  transition: background 200ms ease, color 200ms ease, transform 160ms ease;
}

.composer button:hover,
.composer .active-tool {
  background: rgba(57, 217, 138, 0.14);
  color: #ffffff;
}

.composer button:active,
.quick-actions button:active {
  transform: scale(0.97);
}

.composer textarea {
  width: 100%;
  height: 48px;
  resize: none;
  border: 0;
  outline: none;
  background: transparent;
  color: #eafff0;
  font: 15px/1.45 "Segoe UI", system-ui, sans-serif;
  padding: 10px 8px;
  box-sizing: border-box;
}

.composer textarea::placeholder {
  color: #7fa99b;
}

.composer .send-button {
  background: var(--accent);
  color: #073d3a;
}

.composer .send-button:hover {
  background: #8bffc0;
  color: #073d3a;
}

.hidden-file {
  display: none;
}

.speech-bubble {
  position: absolute;
  right: clamp(70px, 12vw, 210px);
  top: 32%;
  width: min(260px, 24vw);
  display: grid;
  gap: 10px;
  padding: 22px 24px;
  border: 1px solid rgba(238, 255, 246, 0.24);
  border-radius: 28px;
  color: #f7fff9;
  background: rgba(5, 116, 106, 0.34);
  box-shadow: 0 24px 70px rgba(4, 84, 75, 0.2);
  backdrop-filter: blur(18px);
}

.speech-bubble::before {
  content: "";
  position: absolute;
  left: -18px;
  top: 56%;
  width: 28px;
  height: 28px;
  background: inherit;
  border-left: 1px solid rgba(238, 255, 246, 0.2);
  border-bottom: 1px solid rgba(238, 255, 246, 0.2);
  transform: rotate(45deg);
}

.speech-bubble strong {
  font-size: clamp(18px, 1.5vw, 24px);
}

.speech-bubble span {
  color: rgba(244, 255, 248, 0.88);
  font-size: clamp(15px, 1.2vw, 19px);
  line-height: 1.45;
}



.portable-status span {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  padding: 0 12px;
  border-radius: 16px;
  color: #effff5;
  background: rgba(5, 90, 82, 0.28);
  font-weight: 650;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.settings-panel {
  width: 360px;
  background: linear-gradient(180deg, #0a1d1a, #071412);
  color: #e9fff2;
  border-left: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  gap: 18px;
  padding: 22px;
  box-shadow: -24px 0 70px rgba(0, 0, 0, 0.22);
}

.settings-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border);
}

.settings-head h2 {
  margin: 0;
  font-size: 21px;
  font-weight: 620;
}

.settings-head button {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  background: rgba(57, 217, 138, 0.1);
  color: #e9fff2;
}

.settings-panel section {
  display: grid;
  gap: 12px;
}

.settings-panel h3 {
  margin: 0;
  color: #95efbd;
  font-size: 13px;
  font-weight: 650;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.settings-panel label {
  display: grid;
  gap: 7px;
  color: #c8f8d4;
  font-size: 14px;
  font-weight: 520;
}

.settings-panel input,
.settings-panel select {
  width: 100%;
  min-height: 44px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: #102f2b;
  color: #e9fff2;
  padding: 0 12px;
  box-sizing: border-box;
  outline: none;
}

.toggle-row {
  grid-template-columns: 1fr auto;
  align-items: center;
}

.toggle-row input {
  width: 20px;
  min-height: 20px;
  accent-color: var(--accent);
}

.settings-action {
  min-height: 42px;
  border-radius: 14px;
  background: var(--accent);
  color: #06201c;
  font-weight: 650;
}

.settings-summary {
  display: grid;
  gap: 8px;
}

.settings-summary p {
  display: grid;
  grid-template-columns: 120px minmax(0, 1fr);
  gap: 12px;
  margin: 0;
  padding: 10px 12px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: rgba(3, 18, 17, 0.42);
}

.settings-summary strong {
  color: #dfffea;
}

.settings-summary span {
  color: var(--muted);
  overflow-wrap: anywhere;
}

.reminder-backdrop {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: grid;
  place-items: center;
  padding: 24px;
  background: rgba(0, 10, 8, 0.58);
  backdrop-filter: blur(14px);
}

.reminder-popup {
  width: min(520px, 100%);
  display: grid;
  grid-template-columns: 82px minmax(0, 1fr);
  gap: 18px;
  align-items: center;
  padding: 22px;
  border: 1px solid rgba(124, 255, 189, 0.38);
  border-radius: 28px;
  background:
    radial-gradient(circle at top left, rgba(61, 255, 138, 0.22), transparent 42%),
    rgba(3, 27, 24, 0.92);
  box-shadow: 0 26px 90px rgba(0, 0, 0, 0.42), 0 0 40px rgba(61, 255, 138, 0.14);
}

.reminder-popup img {
  width: 76px;
  height: 76px;
  object-fit: contain;
  filter: drop-shadow(0 12px 22px rgba(0, 0, 0, 0.35));
}

.reminder-popup span {
  color: var(--accent);
  font-weight: 750;
}

.reminder-popup h2 {
  margin: 5px 0 8px;
  color: var(--text);
  font-size: 24px;
}

.reminder-popup p {
  margin: 0;
  color: var(--muted);
}

.reminder-popup .button-row {
  grid-column: 1 / -1;
  justify-content: flex-end;
}

.reminder-popup .button-row button:last-child {
  background: var(--accent);
  color: #06201c;
}

.notification-toast {
  position: fixed;
  right: 24px;
  top: 74px;
  z-index: 55;
  width: min(420px, calc(100vw - 48px));
  display: grid;
  grid-template-columns: 52px minmax(0, 1fr) auto;
  gap: 12px;
  align-items: center;
  padding: 14px;
  border: 1px solid rgba(124, 255, 189, 0.34);
  border-radius: 22px;
  background: rgba(3, 27, 24, 0.94);
  box-shadow: 0 18px 64px rgba(0, 0, 0, 0.38), 0 0 32px rgba(61, 255, 138, 0.12);
}

.notification-toast img {
  width: 48px;
  height: 48px;
  object-fit: contain;
}

.notification-toast span {
  color: var(--accent);
  font-weight: 800;
}

.notification-toast p {
  margin: 3px 0 0;
  color: var(--text);
  font-size: 13px;
}

.notification-toast button {
  min-height: 36px;
  padding: 0 14px;
  border-radius: 14px;
  background: var(--accent);
  color: #06201c;
  font-weight: 800;
}

@keyframes pulse {
  0%,
  100% {
    opacity: 0.55;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.25);
  }
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes voiceBars {
  0%,
  100% {
    transform: scaleY(0.45);
    opacity: 0.55;
  }
  50% {
    transform: scaleY(1);
    opacity: 1;
  }
}

