      "temperature": 0.7,
      "maxTokens": 8192,
      "contextWindowTokens": 32768,
      "reasoningEffort": "medium",
      "maxToolIterations": 25,
      "maxConcurrentSubagents": 3,
      "timezone": "America/Sao_Paulo",
